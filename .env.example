# Copy this file to .env and fill in your own values.
# Warning: VITE_* variables are inlined into the client bundle and are
# visible to anyone who opens the app. Use a throwaway key for local
# development only, and never deploy this app publicly with a real key.

VITE_OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-4.1-mini.
VITE_OPENAI_MODEL=gpt-4.1-mini
